{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "timezone-converter",
  "title": "Timezone Converter",
  "description": "Converts any time to any timezone",
  "icon": "assets/command-icon.png",
  "author": "almatkai",
  "categories": ["Developer Tools"],
  "contributors": ["pernielsentikaer", "ridemountainpig"],
  "license": "MIT",
  "platforms": ["macOS", "Windows"],
  "commands": [
    {
      "name": "index",
      "title": "Timezone Converter",
      "description": "Converts any time to any timezone",
      "mode": "view",
      "platforms": ["macOS", "Windows"]
    }
  ],
  "preferences": [
    {
      "name": "sortTimezones",
      "description": "Sort added timezones",
      "type": "dropdown",
      "required": true,
      "title": "Sort Options",
      "placeholder": "Sort the list of added timezones",
      "data": [
        { "title": "Sort Alphabetically", "value": "alphabetically" },
        { "title": "Sort Manually", "value": "manually" }
      ]
    },
    {
      "name": "hideWorldMap",
      "description": "Hide world map to display more time zones in the list",
      "label": "Hide World Map",
      "type": "checkbox",
      "required": false,
      "title": "Hide World Map",
      "default": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.5",
    "luxon": "^3.2.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.timezone-converter",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": ["macos", "windows"],
    "repository": "https://github.com/almatkai/timezone-converter",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/timezone-converter",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    },
    "linuxStatus": "coming-soon"
  }
}
